# Node packages for blueprint/tools (PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npm ci there)
node_modules/

# Rust build output, and the test vectors core/ci.sh writes into core/target
target/

# Screenshots and renders from blueprint/tools
blueprint/tools/out/
*.png
# The retail app's own icons are not renders: an app cannot be built without them.
!apps/retail/assets/**/*.png

# Java codecs from interfaces/tools/sbe.sh (the Rust codec is committed as core/journal)
interfaces/generated/

# Python bytecode
__pycache__/

# Claude Code worktrees and local state
.claude/

# The FIX adapter's toolchain (adapters/fix/bootstrap.sh), Gradle state and build output
adapters/fix/.toolchain/
adapters/fix/.gradle/
adapters/fix/build/
adapters/fix/gradle/wrapper/gradle-wrapper.jar

# Where a venue's address is set for a local app build (EXPO_PUBLIC_VENUE_URL). Kept out of the repository because
# an address of somebody's own network is theirs, not the project's (apps/retail/README.md, pointing it at a venue).
.env.local
.env.*.local
