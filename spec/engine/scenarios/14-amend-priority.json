{
  "name": "A size reduction keeps queue priority; a price change loses it",
  "rules": ["E-12.3", "E-12.4", "E-12.5", "E-10.4"],
  "notes": [
    "A bids 10 at 40c (reserve 400), then B bids 5 at 40c (reserve 200): A is first in the queue.",
    "Step 1: A reduces to 6. Priority is kept; reservation 240; the level becomes 11 across 2 orders.",
    "Step 2: C sells 7 at 40c IOC (reserve noCost(39, 7) = 420). A, still first, fills 6 (buyer -240, seller 240 - 600 = -360); B fills 1 (buyer -40, seller 40 - 100 = -60). B keeps 4 bid, reserve 160.",
    "Step 3: B moves its 4 to 45c. The extra reservation is yesCost(44, 4) - 160 = 180 - 160 = 20, which B can afford. It loses priority, finds no offer, and rests at 45c."
  ],
  "setup": [
    {"op": "centTable", "tickTableId": 1},
    {"op": "binary", "eventId": 100, "instrumentId": 1000},
    {"op": "fund", "accountId": 1, "cents": 10000},
    {"op": "fund", "accountId": 2, "cents": 10000},
    {"op": "fund", "accountId": 3, "cents": 10000}
  ],
  "steps": [
    {"input": {"msg": "NewOrder", "accountId": 1, "clientOrderId": "a1", "instrumentId": 1000, "side": "BUY", "tick": 39, "quantity": 10}, "expect": null},
    {"input": {"msg": "NewOrder", "accountId": 2, "clientOrderId": "b1", "instrumentId": 1000, "side": "BUY", "tick": 39, "quantity": 5}, "expect": null},
    {"input": {"msg": "AmendOrder", "accountId": 1, "instrumentId": 1000, "orderId": "O1", "newQuantity": 6},
     "expect": [
       {"msg": "OrderAmended", "orderId": "O1", "accountId": 1, "instrumentId": 1000, "tick": 39, "quantity": 6, "atEventStart": "CANCEL", "priorityKept": "TRUE"},
       {"msg": "SleeveChanged", "accountId": 1, "availableCents": 9760, "reservedCents": 240},
       {"msg": "BookLevelChanged", "instrumentId": 1000, "side": "BUY", "tick": 39, "quantity": 11, "orderCount": 2}
     ]},
    {"input": {"msg": "NewOrder", "accountId": 3, "clientOrderId": "c1", "instrumentId": 1000, "side": "SELL", "tick": 39, "quantity": 7, "timeInForce": "IOC"},
     "expect": [
       {"msg": "OrderAccepted", "orderId": "O3", "accountId": 3, "clientOrderId": "c1", "instrumentId": 1000, "side": "SELL", "tick": 39, "quantity": 7, "reservedCents": 420},
       {"msg": "Fill", "tradeId": "T1", "instrumentId": 1000, "tick": 39, "quantity": 6, "makerOrderId": "O1", "makerAccountId": 1, "makerRemaining": 0, "takerOrderId": "O3", "takerAccountId": 3, "takerRemaining": 1, "takerSide": "SELL", "mintedPairs": 6, "burnedPairs": 0, "buyerCashCents": -240, "sellerCashCents": -360},
       {"msg": "Fill", "tradeId": "T2", "instrumentId": 1000, "tick": 39, "quantity": 1, "makerOrderId": "O2", "makerAccountId": 2, "makerRemaining": 4, "takerOrderId": "O3", "takerAccountId": 3, "takerRemaining": 0, "takerSide": "SELL", "mintedPairs": 1, "burnedPairs": 0, "buyerCashCents": -40, "sellerCashCents": -60},
       {"msg": "PositionChanged", "accountId": 1, "instrumentId": 1000, "position": 6},
       {"msg": "PositionChanged", "accountId": 2, "instrumentId": 1000, "position": 1},
       {"msg": "PositionChanged", "accountId": 3, "instrumentId": 1000, "position": -7},
       {"msg": "SleeveChanged", "accountId": 1, "availableCents": 9760, "reservedCents": 0},
       {"msg": "SleeveChanged", "accountId": 2, "availableCents": 9800, "reservedCents": 160},
       {"msg": "SleeveChanged", "accountId": 3, "availableCents": 9580, "reservedCents": 0},
       {"msg": "BookLevelChanged", "instrumentId": 1000, "side": "BUY", "tick": 39, "quantity": 4, "orderCount": 1}
     ]},
    {"input": {"msg": "AmendOrder", "accountId": 2, "instrumentId": 1000, "orderId": "O2", "newTick": 44},
     "expect": [
       {"msg": "OrderAmended", "orderId": "O2", "accountId": 2, "instrumentId": 1000, "tick": 44, "quantity": 4, "atEventStart": "CANCEL", "priorityKept": "FALSE"},
       {"msg": "SleeveChanged", "accountId": 2, "availableCents": 9780, "reservedCents": 180},
       {"msg": "BookLevelChanged", "instrumentId": 1000, "side": "BUY", "tick": 39, "quantity": 0, "orderCount": 0},
       {"msg": "BookLevelChanged", "instrumentId": 1000, "side": "BUY", "tick": 44, "quantity": 4, "orderCount": 1}
     ]}
  ]
}
