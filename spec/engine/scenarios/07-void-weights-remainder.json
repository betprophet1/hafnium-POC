{
  "name": "A weighted void floors each payout and pays the remainder to the settlement reserve",
  "rules": ["E-15.3", "E-15.4", "E-15.5", "E-15.6"],
  "notes": [
    "Prelude: A buys 1 YES at 50c from B (balances 9950 each). Collateral 100.",
    "VOID with state 0 weighted 1 and state 1 weighted 2, W = 3. YES pays in state 1 only.",
    "A (+1): (1*0 + 2*100) / 3 = 66.67, floored to 66. B (-1): (1*100 + 2*0) / 3 = 33.33, floored to 33.",
    "Remainder 100 - 99 = 1 goes to account 0. Account 0 is first in sorted order."
  ],
  "setup": [
    {"op": "centTable", "tickTableId": 1},
    {"op": "binary", "eventId": 100, "instrumentId": 1000},
    {"op": "fund", "accountId": 1, "cents": 10000},
    {"op": "fund", "accountId": 2, "cents": 10000}
  ],
  "steps": [
    {"input": {"msg": "NewOrder", "accountId": 1, "clientOrderId": "a1", "instrumentId": 1000, "side": "BUY", "tick": 49, "quantity": 1}, "expect": null},
    {"input": {"msg": "NewOrder", "accountId": 2, "clientOrderId": "b1", "instrumentId": 1000, "side": "SELL", "tick": 49, "quantity": 1}, "expect": null},
    {"input": {"msg": "ResolveEvent", "commandId": "r1", "eventId": 100, "kind": "VOID", "caseId": 7, "voidWeights": [{"state": 0, "weight": 1}, {"state": 1, "weight": 2}]},
     "expect": [
       {"msg": "CommandApplied", "commandId": "r1", "outcome": "APPLIED"},
       {"msg": "MarketStateChanged", "instrumentId": 1000, "state": "VOIDED"},
       {"msg": "SettlementPayout", "accountId": 1, "instrumentId": 1000, "kind": "VOID", "positionClosed": 1, "cents": 66},
       {"msg": "SettlementPayout", "accountId": 2, "instrumentId": 1000, "kind": "VOID", "positionClosed": -1, "cents": 33},
       {"msg": "SettlementPayout", "accountId": 0, "instrumentId": 0, "kind": "VOID", "positionClosed": 0, "cents": 1},
       {"msg": "PositionChanged", "accountId": 1, "instrumentId": 1000, "position": 0},
       {"msg": "PositionChanged", "accountId": 2, "instrumentId": 1000, "position": 0},
       {"msg": "SleeveChanged", "accountId": 0, "availableCents": 1, "reservedCents": 0},
       {"msg": "SleeveChanged", "accountId": 1, "availableCents": 10016, "reservedCents": 0},
       {"msg": "SleeveChanged", "accountId": 2, "availableCents": 9983, "reservedCents": 0}
     ]}
  ]
}
