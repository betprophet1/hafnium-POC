{
  "name": "A void reverses a resale whose proceeds were withdrawn, leaving the seller below zero until funded",
  "rules": ["E-3.3", "E-7.2", "E-9.3", "E-15.3", "E-15.4", "E-15.5", "E-15.6"],
  "notes": [
    "Every account starts with 1000c. Tick 39 is 40c, tick 89 is 90c.",
    "Steps 1-2: A buys 1 YES at 40c from B, who sells from flat (pays 60c for NO). Collateral 100. eventCash: A -40, B -60.",
    "Steps 3-4: A resells the YES to C at 90c. A: 1050 available, eventCash +50. C: 910, eventCash -90.",
    "Step 5: A withdraws all 1050.",
    "Step 6: a VOID that gives weights is refused (D-1).",
    "Step 7: the VOID pays the negation of each eventCash: A -50, B +60, C +90, summing to the collateral. A is at -50.",
    "Step 8: A cannot spend: a 1c order compares with max(0, -50) = 0 and is refused. Step 9: nor withdraw.",
    "Step 10: a grant of 50 brings A back to 0."
  ],
  "setup": [
    {"op": "centTable", "tickTableId": 1},
    {"op": "binary", "eventId": 100, "instrumentId": 1000},
    {"op": "binary", "eventId": 200, "instrumentId": 2000},
    {"op": "fund", "accountId": 1, "cents": 1000},
    {"op": "fund", "accountId": 2, "cents": 1000},
    {"op": "fund", "accountId": 3, "cents": 1000}
  ],
  "steps": [
    {"input": {"msg": "NewOrder", "accountId": 1, "clientOrderId": "a1", "instrumentId": 1000, "side": "BUY", "tick": 39, "quantity": 1}, "expect": null},
    {"input": {"msg": "NewOrder", "accountId": 2, "clientOrderId": "b1", "instrumentId": 1000, "side": "SELL", "tick": 39, "quantity": 1}, "expect": null},
    {"input": {"msg": "NewOrder", "accountId": 1, "clientOrderId": "a2", "instrumentId": 1000, "side": "SELL", "tick": 89, "quantity": 1}, "expect": null},
    {"input": {"msg": "NewOrder", "accountId": 3, "clientOrderId": "c1", "instrumentId": 1000, "side": "BUY", "tick": 89, "quantity": 1}, "expect": null},
    {"input": {"msg": "SleeveAdjust", "commandId": "w1", "accountId": 1, "deltaCents": 1050, "reason": "RECLAIM"},
     "expect": [
       {"msg": "CommandApplied", "commandId": "w1", "outcome": "APPLIED"},
       {"msg": "SleeveChanged", "accountId": 1, "availableCents": 0, "reservedCents": 0}
     ]},
    {"input": {"msg": "ResolveEvent", "commandId": "r1", "eventId": 100, "kind": "VOID", "caseId": 7, "voidWeights": [{"state": 0, "weight": 1}]},
     "expect": [
       {"msg": "CommandApplied", "commandId": "r1", "outcome": "REJECTED", "rejectReason": "INVALID_COMMAND"}
     ]},
    {"input": {"msg": "ResolveEvent", "commandId": "r2", "eventId": 100, "kind": "VOID", "caseId": 7, "voidWeights": []},
     "expect": [
       {"msg": "CommandApplied", "commandId": "r2", "outcome": "APPLIED"},
       {"msg": "MarketStateChanged", "instrumentId": 1000, "state": "VOIDED"},
       {"msg": "SettlementPayout", "accountId": 1, "instrumentId": 0, "kind": "VOID", "positionClosed": 0, "cents": -50},
       {"msg": "SettlementPayout", "accountId": 2, "instrumentId": 0, "kind": "VOID", "positionClosed": 0, "cents": 60},
       {"msg": "SettlementPayout", "accountId": 3, "instrumentId": 0, "kind": "VOID", "positionClosed": 0, "cents": 90},
       {"msg": "PositionChanged", "accountId": 2, "instrumentId": 1000, "position": 0},
       {"msg": "PositionChanged", "accountId": 3, "instrumentId": 1000, "position": 0},
       {"msg": "SleeveChanged", "accountId": 1, "availableCents": -50, "reservedCents": 0},
       {"msg": "SleeveChanged", "accountId": 2, "availableCents": 1000, "reservedCents": 0},
       {"msg": "SleeveChanged", "accountId": 3, "availableCents": 1000, "reservedCents": 0}
     ]},
    {"input": {"msg": "NewOrder", "accountId": 1, "clientOrderId": "a3", "instrumentId": 2000, "side": "BUY", "tick": 0, "quantity": 1},
     "expect": [
       {"msg": "OrderRejected", "accountId": 1, "clientOrderId": "a3", "instrumentId": 2000, "reason": "INSUFFICIENT_SLEEVE"}
     ]},
    {"input": {"msg": "SleeveAdjust", "commandId": "w2", "accountId": 1, "deltaCents": 1, "reason": "RECLAIM"},
     "expect": [
       {"msg": "CommandApplied", "commandId": "w2", "outcome": "REJECTED", "rejectReason": "INSUFFICIENT_SLEEVE"}
     ]},
    {"input": {"msg": "SleeveAdjust", "commandId": "g1", "accountId": 1, "deltaCents": 50, "reason": "GRANT"},
     "expect": [
       {"msg": "CommandApplied", "commandId": "g1", "outcome": "APPLIED"},
       {"msg": "SleeveChanged", "accountId": 1, "availableCents": 0, "reservedCents": 0}
     ]}
  ]
}
