     "expect": [
       {"msg": "OrderAccepted", "orderId": "O8", "accountId": 3, "clientOrderId": "c2", "instrumentId": 1010, "side": "SELL", "tick": 49, "quantity": 10, "reservedCents": 500},
       {"msg": "Fill", "tradeId": "T4", "instrumentId": 1010, "tick": 49, "quantity": 10, "makerOrderId": "O7", "makerAccountId": 1, "makerRemaining": 0, "takerOrderId": "O8", "takerAccountId": 3, "takerRemaining": 0, "takerSide": "SELL", "mintedPairs": 10, "burnedPairs": 0, "buyerCashCents": -500, "sellerCashCents": -500, "makerFeeCents": 0, "takerFeeCents": 0},
       {"msg": "PositionChanged", "accountId": 1, "instrumentId": 1010, "position": 30},
       {"msg": "PositionChanged", "accountId": 3, "instrumentId": 1010, "position": -20},
       {"msg": "SleeveChanged", "accountId": 1, "availableCents": 8000, "reservedCents": 0},
       {"msg": "SleeveChanged", "accountId": 3, "availableCents": 9000, "reservedCents": 0},
       {"msg": "BookLevelChanged", "instrumentId": 1010, "side": "BUY", "tick": 49, "quantity": 0, "orderCount": 0}
     ]},
    {"input": {"msg": "SetFeeOverride", "commandId": "o4", "overrideId": 4, "priority": 1, "accountId": 0, "instrumentId": 0, "eventId": 101, "makerRateMicros": 0, "takerRateMicros": 10000},
     "expect": [
