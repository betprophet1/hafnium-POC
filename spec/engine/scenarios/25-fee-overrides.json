       {"msg": "Fill", "tradeId": "T5", "instrumentId": 1010, "tick": 49, "quantity": 10, "makerOrderId": "O9", "makerAccountId": 1, "makerRemaining": 0, "takerOrderId": "O10", "takerAccountId": 3, "takerRemaining": 0, "takerSide": "SELL", "mintedPairs": 10, "burnedPairs": 0, "buyerCashCents": -500, "sellerCashCents": -500, "makerFeeCents": 0, "takerFeeCents": 3},
       {"msg": "PositionChanged", "accountId": 1, "instrumentId": 1010, "position": 40},
