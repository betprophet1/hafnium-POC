     ]},
    {"input": {"msg": "NewOrder", "accountId": 1, "clientOrderId": "a5", "instrumentId": 1010, "side": "BUY", "tick": 49, "quantity": 10},
     "expect": [
       {"msg": "OrderAccepted", "orderId": "O9", "accountId": 1, "clientOrderId": "a5", "instrumentId": 1010, "side": "BUY", "tick": 49, "quantity": 10, "reservedCents": 500},
       {"msg": "SleeveChanged", "accountId": 1, "availableCents": 7500, "reservedCents": 500},
