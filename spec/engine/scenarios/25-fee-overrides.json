     ]},
    {"input": {"msg": "SetFeeOverride", "commandId": "o3", "overrideId": 3, "priority": 5, "accountId": 3, "instrumentId": 1010, "eventId": 0, "makerRateMicros": 0, "takerRateMicros": 35000},
     "expect": [
       {"msg": "CommandApplied", "commandId": "o3", "outcome": "APPLIED"}
     ]},
    {"input": {"msg": "NewOrder", "accountId": 1, "clientOrderId": "a4", "instrumentId": 1010, "side": "BUY", "tick": 49, "quantity": 10},
     "expect": [
       {"msg": "OrderAccepted", "orderId": "O7", "accountId": 1, "clientOrderId": "a4", "instrumentId": 1010, "side": "BUY", "tick": 49, "quantity": 10, "reservedCents": 500},
       {"msg": "SleeveChanged", "accountId": 1, "availableCents": 8000, "reservedCents": 500},
       {"msg": "BookLevelChanged", "instrumentId": 1010, "side": "BUY", "tick": 49, "quantity": 10, "orderCount": 1}
     ]},
