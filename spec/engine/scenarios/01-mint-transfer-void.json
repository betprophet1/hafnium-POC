{
  "name": "Mint, transfer, then void at equal weights",
  "rules": ["E-5.2", "E-9.8", "E-10.6", "E-11.1", "E-11.2", "E-15.4", "E-15.5"],
  "notes": [
    "Tick 39 is 40c, tick 69 is 70c. Every account starts with $100.00 (10000c).",
    "Step 1: A bids 10 at 40c. Reservation = yesCost(39, 10) = 400.",
    "Step 2: B sells 10 at 40c from flat. Reservation = noCost = 1000 - 400 = 600. Both flat: bBurn 0, sReduce 0, minted 10. buyerCash -400, sellerCash 400 - 1000 = -600.",
    "Step 3: A offers 4 at 70c holding 10 YES: lock 4, reservation noCost(69, 0) = 0.",
    "Step 4: C buys A's 4 at 70c. sReduce 4 so minted 0: a transfer. buyerCash -280, sellerCash +280. A now 6 YES, C 4 YES, B 10 NO.",
    "Step 5: VOID with no weights: both states weight 1, W = 2. A: (0 + 600) / 2 = 300. B: (1000 + 0) / 2 = 500. C: (0 + 400) / 2 = 200. Sum 1000 = collateral, no remainder.",
    "Refunding cost basis instead would owe C 280 and B 600 from a 1000c pool that also owes A: this is decision D-1."
  ],
  "setup": [
    {"op": "centTable", "tickTableId": 1},
    {"op": "binary", "eventId": 100, "instrumentId": 1000},
    {"op": "fund", "accountId": 1, "cents": 10000},
    {"op": "fund", "accountId": 2, "cents": 10000},
    {"op": "fund", "accountId": 3, "cents": 10000}
  ],
  "steps": [
    {"input": {"msg": "NewOrder", "accountId": 1, "clientOrderId": "a1", "instrumentId": 1000, "side": "BUY", "tick": 39, "quantity": 10},
     "expect": [
       {"msg": "OrderAccepted", "orderId": "O1", "accountId": 1, "clientOrderId": "a1", "instrumentId": 1000, "side": "BUY", "tick": 39, "quantity": 10, "reservedCents": 400},
       {"msg": "SleeveChanged", "accountId": 1, "availableCents": 9600, "reservedCents": 400},
       {"msg": "BookLevelChanged", "instrumentId": 1000, "side": "BUY", "tick": 39, "quantity": 10, "orderCount": 1}
     ]},
    {"input": {"msg": "NewOrder", "accountId": 2, "clientOrderId": "b1", "instrumentId": 1000, "side": "SELL", "tick": 39, "quantity": 10},
     "expect": [
       {"msg": "OrderAccepted", "orderId": "O2", "accountId": 2, "clientOrderId": "b1", "instrumentId": 1000, "side": "SELL", "tick": 39, "quantity": 10, "reservedCents": 600},
       {"msg": "Fill", "tradeId": "T1", "instrumentId": 1000, "tick": 39, "quantity": 10, "makerOrderId": "O1", "makerAccountId": 1, "makerRemaining": 0, "takerOrderId": "O2", "takerAccountId": 2, "takerRemaining": 0, "takerSide": "SELL", "mintedPairs": 10, "burnedPairs": 0, "buyerCashCents": -400, "sellerCashCents": -600},
       {"msg": "PositionChanged", "accountId": 1, "instrumentId": 1000, "position": 10},
       {"msg": "PositionChanged", "accountId": 2, "instrumentId": 1000, "position": -10},
       {"msg": "SleeveChanged", "accountId": 1, "availableCents": 9600, "reservedCents": 0},
       {"msg": "SleeveChanged", "accountId": 2, "availableCents": 9400, "reservedCents": 0},
       {"msg": "BookLevelChanged", "instrumentId": 1000, "side": "BUY", "tick": 39, "quantity": 0, "orderCount": 0}
     ]},
    {"input": {"msg": "NewOrder", "accountId": 1, "clientOrderId": "a2", "instrumentId": 1000, "side": "SELL", "tick": 69, "quantity": 4},
     "expect": [
       {"msg": "OrderAccepted", "orderId": "O3", "accountId": 1, "clientOrderId": "a2", "instrumentId": 1000, "side": "SELL", "tick": 69, "quantity": 4, "reservedCents": 0},
       {"msg": "BookLevelChanged", "instrumentId": 1000, "side": "SELL", "tick": 69, "quantity": 4, "orderCount": 1}
     ]},
    {"input": {"msg": "NewOrder", "accountId": 3, "clientOrderId": "c1", "instrumentId": 1000, "side": "BUY", "tick": 69, "quantity": 4},
     "expect": [
       {"msg": "OrderAccepted", "orderId": "O4", "accountId": 3, "clientOrderId": "c1", "instrumentId": 1000, "side": "BUY", "tick": 69, "quantity": 4, "reservedCents": 280},
       {"msg": "Fill", "tradeId": "T2", "instrumentId": 1000, "tick": 69, "quantity": 4, "makerOrderId": "O3", "makerAccountId": 1, "makerRemaining": 0, "takerOrderId": "O4", "takerAccountId": 3, "takerRemaining": 0, "takerSide": "BUY", "mintedPairs": 0, "burnedPairs": 0, "buyerCashCents": -280, "sellerCashCents": 280},
       {"msg": "PositionChanged", "accountId": 1, "instrumentId": 1000, "position": 6},
       {"msg": "PositionChanged", "accountId": 3, "instrumentId": 1000, "position": 4},
       {"msg": "SleeveChanged", "accountId": 1, "availableCents": 9880, "reservedCents": 0},
       {"msg": "SleeveChanged", "accountId": 3, "availableCents": 9720, "reservedCents": 0},
       {"msg": "BookLevelChanged", "instrumentId": 1000, "side": "SELL", "tick": 69, "quantity": 0, "orderCount": 0}
     ]},
    {"input": {"msg": "ResolveEvent", "commandId": "r1", "eventId": 100, "kind": "VOID", "caseId": 1, "voidWeights": []},
     "expect": [
       {"msg": "CommandApplied", "commandId": "r1", "outcome": "APPLIED"},
       {"msg": "MarketStateChanged", "instrumentId": 1000, "state": "VOIDED"},
       {"msg": "SettlementPayout", "accountId": 1, "instrumentId": 1000, "kind": "VOID", "positionClosed": 6, "cents": 300},
       {"msg": "SettlementPayout", "accountId": 2, "instrumentId": 1000, "kind": "VOID", "positionClosed": -10, "cents": 500},
       {"msg": "SettlementPayout", "accountId": 3, "instrumentId": 1000, "kind": "VOID", "positionClosed": 4, "cents": 200},
       {"msg": "PositionChanged", "accountId": 1, "instrumentId": 1000, "position": 0},
       {"msg": "PositionChanged", "accountId": 2, "instrumentId": 1000, "position": 0},
       {"msg": "PositionChanged", "accountId": 3, "instrumentId": 1000, "position": 0},
       {"msg": "SleeveChanged", "accountId": 1, "availableCents": 10180, "reservedCents": 0},
       {"msg": "SleeveChanged", "accountId": 2, "availableCents": 9900, "reservedCents": 0},
       {"msg": "SleeveChanged", "accountId": 3, "availableCents": 9920, "reservedCents": 0}
     ]}
  ]
}
