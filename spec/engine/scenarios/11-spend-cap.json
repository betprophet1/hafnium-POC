{
  "name": "A spend cap limits gross spend across price levels",
  "rules": ["E-2.7", "E-9.6", "E-10.3", "E-11.2", "E-11.3", "E-9.9"],
  "notes": [
    "Offers: 3 at 40c (account 2) and 5 at 50c (account 3), each from flat.",
    "A bids up to 100 at 60c, IOC, with a spend cap of 300c. One lot at 60c costs 60 <= 300, so accepted; reservation min(100 * 60, 300) = 300.",
    "At 40c the cap affords floor(300 / 40) = 7, so Q = 7, but only 3 are offered: fill 3 for 120, cap left 180.",
    "At 50c the cap affords floor(180 / 50) = 3: fill 3 of the 5 for 150, cap left 30.",
    "At 50c again the cap affords 0, so the walk stops. The IOC remainder of 94 is cancelled.",
    "Account 3 keeps 2 offered: reservation noCost(49, 2) = 100."
  ],
  "setup": [
    {"op": "centTable", "tickTableId": 1},
    {"op": "binary", "eventId": 100, "instrumentId": 1000},
    {"op": "fund", "accountId": 1, "cents": 10000},
    {"op": "fund", "accountId": 2, "cents": 10000},
    {"op": "fund", "accountId": 3, "cents": 10000}
  ],
  "steps": [
    {"input": {"msg": "NewOrder", "accountId": 2, "clientOrderId": "m1", "instrumentId": 1000, "side": "SELL", "tick": 39, "quantity": 3}, "expect": null},
    {"input": {"msg": "NewOrder", "accountId": 3, "clientOrderId": "m2", "instrumentId": 1000, "side": "SELL", "tick": 49, "quantity": 5}, "expect": null},
    {"input": {"msg": "NewOrder", "accountId": 1, "clientOrderId": "a1", "instrumentId": 1000, "side": "BUY", "tick": 59, "quantity": 100, "timeInForce": "IOC", "spendCapCents": 300},
     "expect": [
       {"msg": "OrderAccepted", "orderId": "O3", "accountId": 1, "clientOrderId": "a1", "instrumentId": 1000, "side": "BUY", "tick": 59, "quantity": 100, "reservedCents": 300},
       {"msg": "Fill", "tradeId": "T1", "instrumentId": 1000, "tick": 39, "quantity": 3, "makerOrderId": "O1", "makerAccountId": 2, "makerRemaining": 0, "takerOrderId": "O3", "takerAccountId": 1, "takerRemaining": 97, "takerSide": "BUY", "mintedPairs": 3, "burnedPairs": 0, "buyerCashCents": -120, "sellerCashCents": -180},
       {"msg": "Fill", "tradeId": "T2", "instrumentId": 1000, "tick": 49, "quantity": 3, "makerOrderId": "O2", "makerAccountId": 3, "makerRemaining": 2, "takerOrderId": "O3", "takerAccountId": 1, "takerRemaining": 94, "takerSide": "BUY", "mintedPairs": 3, "burnedPairs": 0, "buyerCashCents": -150, "sellerCashCents": -150},
       {"msg": "OrderCancelled", "orderId": "O3", "accountId": 1, "instrumentId": 1000, "cancelledQuantity": 94, "reason": "IOC_REMAINDER"},
       {"msg": "PositionChanged", "accountId": 1, "instrumentId": 1000, "position": 6},
       {"msg": "PositionChanged", "accountId": 2, "instrumentId": 1000, "position": -3},
       {"msg": "PositionChanged", "accountId": 3, "instrumentId": 1000, "position": -3},
       {"msg": "SleeveChanged", "accountId": 1, "availableCents": 9730, "reservedCents": 0},
       {"msg": "SleeveChanged", "accountId": 2, "availableCents": 9820, "reservedCents": 0},
       {"msg": "SleeveChanged", "accountId": 3, "availableCents": 9750, "reservedCents": 100},
       {"msg": "BookLevelChanged", "instrumentId": 1000, "side": "SELL", "tick": 39, "quantity": 0, "orderCount": 0},
       {"msg": "BookLevelChanged", "instrumentId": 1000, "side": "SELL", "tick": 49, "quantity": 2, "orderCount": 1}
     ]}
  ]
}
