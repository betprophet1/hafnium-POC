{
  "name": "Buying YES in every outcome of a categorical event burns the set at the fill",
  "rules": ["E-6.4", "E-14.3", "E-15.2", "E-5.2"],
  "notes": [
    "Event 200 has three exclusive outcomes, instruments 2001, 2002 and 2003 (masks 1, 2, 4): a partition event.",
    "Prelude: three sellers offer 5 each at 20c, 30c and 40c; A buys the first two, paying 100 and 150 (balance 9750).",
    "Step: A buys 5 of 2003 at 40c (reservation 200; mint, buyer -200, seller 200 - 500 = -300).",
    "End of unit: A holds 5 YES of every outcome, all unlocked, so k = 5: positions fall to 0 and 500 is released. A's balance 9750 - 200 + 500 = 10050.",
    "A's position in 2003 starts and ends the unit at 0, so no PositionChanged is emitted for it.",
    "Collateral 1500 minted - 500 burned = 1000; in every state the three sellers' NO pays 1000."
  ],
  "setup": [
    {"op": "centTable", "tickTableId": 1},
    {"op": "categorical", "eventId": 200, "instrumentIds": [2001, 2002, 2003]},
    {"op": "fund", "accountId": 1, "cents": 10000},
    {"op": "fund", "accountId": 2, "cents": 10000},
    {"op": "fund", "accountId": 3, "cents": 10000},
    {"op": "fund", "accountId": 4, "cents": 10000}
  ],
  "steps": [
    {"input": {"msg": "NewOrder", "accountId": 2, "clientOrderId": "s1", "instrumentId": 2001, "side": "SELL", "tick": 19, "quantity": 5}, "expect": null},
    {"input": {"msg": "NewOrder", "accountId": 3, "clientOrderId": "s2", "instrumentId": 2002, "side": "SELL", "tick": 29, "quantity": 5}, "expect": null},
    {"input": {"msg": "NewOrder", "accountId": 4, "clientOrderId": "s3", "instrumentId": 2003, "side": "SELL", "tick": 39, "quantity": 5}, "expect": null},
    {"input": {"msg": "NewOrder", "accountId": 1, "clientOrderId": "a1", "instrumentId": 2001, "side": "BUY", "tick": 19, "quantity": 5}, "expect": null},
    {"input": {"msg": "NewOrder", "accountId": 1, "clientOrderId": "a2", "instrumentId": 2002, "side": "BUY", "tick": 29, "quantity": 5}, "expect": null},
    {"input": {"msg": "NewOrder", "accountId": 1, "clientOrderId": "a3", "instrumentId": 2003, "side": "BUY", "tick": 39, "quantity": 5},
     "expect": [
       {"msg": "OrderAccepted", "orderId": "O6", "accountId": 1, "clientOrderId": "a3", "instrumentId": 2003, "side": "BUY", "tick": 39, "quantity": 5, "reservedCents": 200},
       {"msg": "Fill", "tradeId": "T3", "instrumentId": 2003, "tick": 39, "quantity": 5, "makerOrderId": "O3", "makerAccountId": 4, "makerRemaining": 0, "takerOrderId": "O6", "takerAccountId": 1, "takerRemaining": 0, "takerSide": "BUY", "mintedPairs": 5, "burnedPairs": 0, "buyerCashCents": -200, "sellerCashCents": -300},
       {"msg": "CollateralReleased", "accountId": 1, "eventId": 200, "cents": 500, "kind": "YES_SET_BURN"},
       {"msg": "PositionChanged", "accountId": 1, "instrumentId": 2001, "position": 0},
       {"msg": "PositionChanged", "accountId": 1, "instrumentId": 2002, "position": 0},
       {"msg": "PositionChanged", "accountId": 4, "instrumentId": 2003, "position": -5},
       {"msg": "SleeveChanged", "accountId": 1, "availableCents": 10050, "reservedCents": 0},
       {"msg": "SleeveChanged", "accountId": 4, "availableCents": 9700, "reservedCents": 0},
       {"msg": "BookLevelChanged", "instrumentId": 2003, "side": "SELL", "tick": 39, "quantity": 0, "orderCount": 0}
     ]}
  ]
}
