{
  "name": "An order group triggers on fills, cancels its orders, refuses new ones until reset",
  "rules": ["E-12.7", "E-13.3", "E-13.4", "E-9.3"],
  "notes": [
    "Group 7 of account 1 allows 2 contracts filled per 1000 ms.",
    "Account 1 offers 1 each at 50c, 51c and 52c in group 7 (reservations 50, 49, 48).",
    "Account 2 bids 2 at 51c: reservation yesCost(50, 2) = 102. Fills 1 at 50c (buyer -50, seller -50) and 1 at 51c (buyer -51, seller -49).",
    "The group's fills reach 2 >= 2: at the end of the unit it triggers and its 52c offer is cancelled.",
    "A new order in group 7 is then refused at check 9 until ResetOrderGroup."
  ],
  "setup": [
    {"op": "centTable", "tickTableId": 1},
    {"op": "binary", "eventId": 100, "instrumentId": 1000},
    {"op": "fund", "accountId": 1, "cents": 10000},
    {"op": "fund", "accountId": 2, "cents": 10000}
  ],
  "steps": [
    {"input": {"msg": "SetOrderGroup", "accountId": 1, "clientOrderGroup": 7, "maxContractsFilledPerWindow": 2, "windowMillis": 1000},
     "expect": [
       {"msg": "OrderGroupUpdated", "accountId": 1, "clientOrderGroup": 7, "maxContractsFilledPerWindow": 2, "windowMillis": 1000, "triggered": "FALSE"}
     ]},
    {"input": {"msg": "NewOrder", "accountId": 1, "clientOrderId": "a1", "instrumentId": 1000, "side": "SELL", "tick": 49, "quantity": 1, "clientOrderGroup": 7}, "expect": null},
    {"input": {"msg": "NewOrder", "accountId": 1, "clientOrderId": "a2", "instrumentId": 1000, "side": "SELL", "tick": 50, "quantity": 1, "clientOrderGroup": 7}, "expect": null},
    {"input": {"msg": "NewOrder", "accountId": 1, "clientOrderId": "a3", "instrumentId": 1000, "side": "SELL", "tick": 51, "quantity": 1, "clientOrderGroup": 7}, "expect": null},
    {"input": {"msg": "NewOrder", "accountId": 2, "clientOrderId": "b1", "instrumentId": 1000, "side": "BUY", "tick": 50, "quantity": 2},
     "expect": [
       {"msg": "OrderAccepted", "orderId": "O4", "accountId": 2, "clientOrderId": "b1", "instrumentId": 1000, "side": "BUY", "tick": 50, "quantity": 2, "reservedCents": 102},
       {"msg": "Fill", "tradeId": "T1", "instrumentId": 1000, "tick": 49, "quantity": 1, "makerOrderId": "O1", "makerAccountId": 1, "makerRemaining": 0, "takerOrderId": "O4", "takerAccountId": 2, "takerRemaining": 1, "takerSide": "BUY", "mintedPairs": 1, "burnedPairs": 0, "buyerCashCents": -50, "sellerCashCents": -50},
       {"msg": "Fill", "tradeId": "T2", "instrumentId": 1000, "tick": 50, "quantity": 1, "makerOrderId": "O2", "makerAccountId": 1, "makerRemaining": 0, "takerOrderId": "O4", "takerAccountId": 2, "takerRemaining": 0, "takerSide": "BUY", "mintedPairs": 1, "burnedPairs": 0, "buyerCashCents": -51, "sellerCashCents": -49},
       {"msg": "OrderGroupUpdated", "accountId": 1, "clientOrderGroup": 7, "maxContractsFilledPerWindow": 2, "windowMillis": 1000, "triggered": "TRUE"},
       {"msg": "OrderCancelled", "orderId": "O3", "accountId": 1, "instrumentId": 1000, "cancelledQuantity": 1, "reason": "ORDER_GROUP_TRIGGERED"},
       {"msg": "PositionChanged", "accountId": 1, "instrumentId": 1000, "position": -2},
       {"msg": "PositionChanged", "accountId": 2, "instrumentId": 1000, "position": 2},
       {"msg": "SleeveChanged", "accountId": 1, "availableCents": 9901, "reservedCents": 0},
       {"msg": "SleeveChanged", "accountId": 2, "availableCents": 9899, "reservedCents": 0},
       {"msg": "BookLevelChanged", "instrumentId": 1000, "side": "SELL", "tick": 49, "quantity": 0, "orderCount": 0},
       {"msg": "BookLevelChanged", "instrumentId": 1000, "side": "SELL", "tick": 50, "quantity": 0, "orderCount": 0},
       {"msg": "BookLevelChanged", "instrumentId": 1000, "side": "SELL", "tick": 51, "quantity": 0, "orderCount": 0}
     ]},
    {"input": {"msg": "NewOrder", "accountId": 1, "clientOrderId": "a4", "instrumentId": 1000, "side": "SELL", "tick": 59, "quantity": 1, "clientOrderGroup": 7},
     "expect": [
       {"msg": "OrderRejected", "accountId": 1, "clientOrderId": "a4", "instrumentId": 1000, "reason": "ORDER_GROUP_TRIGGERED"}
     ]},
    {"input": {"msg": "ResetOrderGroup", "accountId": 1, "clientOrderGroup": 7},
     "expect": [
       {"msg": "OrderGroupUpdated", "accountId": 1, "clientOrderGroup": 7, "maxContractsFilledPerWindow": 2, "windowMillis": 1000, "triggered": "FALSE"}
     ]}
  ]
}
