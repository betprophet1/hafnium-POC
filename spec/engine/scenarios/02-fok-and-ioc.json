{
  "name": "FOK rejects when the book cannot fill it; IOC fills what it can",
  "rules": ["E-9.3", "E-9.9", "E-10.9", "E-5.3"],
  "notes": [
    "Tick 59 is 60c. A offers 5 at 60c from flat: reservation noCost(59, 5) = 500 - 300 = 200.",
    "Step 2: FOK for 8; the dry run fills 5, so FOK_NOT_FILLABLE and no order ID is used.",
    "Step 3: IOC for 8 reserves yesCost(59, 8) = 480, fills 5 (minted: buyer -300, seller 300 - 500 = -200), cancels 3."
  ],
  "setup": [
    {"op": "centTable", "tickTableId": 1},
    {"op": "binary", "eventId": 100, "instrumentId": 1000},
    {"op": "fund", "accountId": 1, "cents": 10000},
    {"op": "fund", "accountId": 2, "cents": 10000}
  ],
  "steps": [
    {"input": {"msg": "NewOrder", "accountId": 1, "clientOrderId": "a1", "instrumentId": 1000, "side": "SELL", "tick": 59, "quantity": 5},
     "expect": [
       {"msg": "OrderAccepted", "orderId": "O1", "accountId": 1, "clientOrderId": "a1", "instrumentId": 1000, "side": "SELL", "tick": 59, "quantity": 5, "reservedCents": 200},
       {"msg": "SleeveChanged", "accountId": 1, "availableCents": 9800, "reservedCents": 200},
       {"msg": "BookLevelChanged", "instrumentId": 1000, "side": "SELL", "tick": 59, "quantity": 5, "orderCount": 1}
     ]},
    {"input": {"msg": "NewOrder", "accountId": 2, "clientOrderId": "b1", "instrumentId": 1000, "side": "BUY", "tick": 59, "quantity": 8, "timeInForce": "FOK"},
     "expect": [
       {"msg": "OrderRejected", "accountId": 2, "clientOrderId": "b1", "instrumentId": 1000, "reason": "FOK_NOT_FILLABLE"}
     ]},
    {"input": {"msg": "NewOrder", "accountId": 2, "clientOrderId": "b2", "instrumentId": 1000, "side": "BUY", "tick": 59, "quantity": 8, "timeInForce": "IOC"},
     "expect": [
       {"msg": "OrderAccepted", "orderId": "O2", "accountId": 2, "clientOrderId": "b2", "instrumentId": 1000, "side": "BUY", "tick": 59, "quantity": 8, "reservedCents": 480},
       {"msg": "Fill", "tradeId": "T1", "instrumentId": 1000, "tick": 59, "quantity": 5, "makerOrderId": "O1", "makerAccountId": 1, "makerRemaining": 0, "takerOrderId": "O2", "takerAccountId": 2, "takerRemaining": 3, "takerSide": "BUY", "mintedPairs": 5, "burnedPairs": 0, "buyerCashCents": -300, "sellerCashCents": -200},
       {"msg": "OrderCancelled", "orderId": "O2", "accountId": 2, "instrumentId": 1000, "cancelledQuantity": 3, "reason": "IOC_REMAINDER"},
       {"msg": "PositionChanged", "accountId": 1, "instrumentId": 1000, "position": -5},
       {"msg": "PositionChanged", "accountId": 2, "instrumentId": 1000, "position": 5},
       {"msg": "SleeveChanged", "accountId": 1, "availableCents": 9800, "reservedCents": 0},
       {"msg": "SleeveChanged", "accountId": 2, "availableCents": 9700, "reservedCents": 0},
       {"msg": "BookLevelChanged", "instrumentId": 1000, "side": "SELL", "tick": 59, "quantity": 0, "orderCount": 0}
     ]}
  ]
}
