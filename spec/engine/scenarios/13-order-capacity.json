{
  "name": "At capacity, an order that would rest is rejected and one that fills completely is accepted",
  "rules": ["E-9.3", "E-10.9", "E-7.4"],
  "notes": [
    "The group's active order limit is 1.",
    "A offers 2 at 50c: the dry run fills nothing, there are 0 resting orders, so it rests (reserve 100).",
    "B bids 1 at 40c: the dry run fills nothing and 1 order already rests, so ORDER_CAPACITY.",
    "B bids 2 at 50c: the dry run fills all 2, so capacity is not checked. Mint: buyer -100, seller 100 - 200 = -100."
  ],
  "setup": [
    {"op": "centTable", "tickTableId": 1},
    {"op": "binary", "eventId": 100, "instrumentId": 1000},
    {"msg": "SetGroupParameters", "activeOrderLimit": 1, "clientOrderIdWindowSeconds": 86400},
    {"op": "fund", "accountId": 1, "cents": 10000},
    {"op": "fund", "accountId": 2, "cents": 10000}
  ],
  "steps": [
    {"input": {"msg": "NewOrder", "accountId": 1, "clientOrderId": "a1", "instrumentId": 1000, "side": "SELL", "tick": 49, "quantity": 2},
     "expect": [
       {"msg": "OrderAccepted", "orderId": "O1", "accountId": 1, "clientOrderId": "a1", "instrumentId": 1000, "side": "SELL", "tick": 49, "quantity": 2, "reservedCents": 100},
       {"msg": "SleeveChanged", "accountId": 1, "availableCents": 9900, "reservedCents": 100},
       {"msg": "BookLevelChanged", "instrumentId": 1000, "side": "SELL", "tick": 49, "quantity": 2, "orderCount": 1}
     ]},
    {"input": {"msg": "NewOrder", "accountId": 2, "clientOrderId": "b1", "instrumentId": 1000, "side": "BUY", "tick": 39, "quantity": 1},
     "expect": [
       {"msg": "OrderRejected", "accountId": 2, "clientOrderId": "b1", "instrumentId": 1000, "reason": "ORDER_CAPACITY"}
     ]},
    {"input": {"msg": "NewOrder", "accountId": 2, "clientOrderId": "b2", "instrumentId": 1000, "side": "BUY", "tick": 49, "quantity": 2},
     "expect": [
       {"msg": "OrderAccepted", "orderId": "O2", "accountId": 2, "clientOrderId": "b2", "instrumentId": 1000, "side": "BUY", "tick": 49, "quantity": 2, "reservedCents": 100},
       {"msg": "Fill", "tradeId": "T1", "instrumentId": 1000, "tick": 49, "quantity": 2, "makerOrderId": "O1", "makerAccountId": 1, "makerRemaining": 0, "takerOrderId": "O2", "takerAccountId": 2, "takerRemaining": 0, "takerSide": "BUY", "mintedPairs": 2, "burnedPairs": 0, "buyerCashCents": -100, "sellerCashCents": -100},
       {"msg": "PositionChanged", "accountId": 1, "instrumentId": 1000, "position": -2},
       {"msg": "PositionChanged", "accountId": 2, "instrumentId": 1000, "position": 2},
       {"msg": "SleeveChanged", "accountId": 1, "availableCents": 9900, "reservedCents": 0},
       {"msg": "SleeveChanged", "accountId": 2, "availableCents": 9900, "reservedCents": 0},
       {"msg": "BookLevelChanged", "instrumentId": 1000, "side": "SELL", "tick": 49, "quantity": 0, "orderCount": 0}
     ]}
  ]
}
