{
  "uid": "venue-trading",
  "title": "Trading",
  "tags": [
    "venue",
    "business"
  ],
  "description": "Volume, fills, active markets and rejections, from the journal.",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "logs",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(up{component=~\"core|gateway|observer|fix\"}, env)",
          "refId": "env"
        },
        "definition": "label_values(up{component=~\"core|gateway|observer|fix\"}, env)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {},
        "hide": 0,
        "allValue": ".*"
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(up{component=~\"core|gateway|observer|fix\", env=~\"$env\"}, namespace)",
          "refId": "namespace"
        },
        "definition": "label_values(up{component=~\"core|gateway|observer|fix\", env=~\"$env\"}, namespace)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {},
        "hide": 0,
        "allValue": ".*"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Venue dashboards",
      "type": "dashboards",
      "tags": [
        "venue"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
