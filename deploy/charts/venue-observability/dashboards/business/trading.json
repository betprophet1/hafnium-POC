      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (market) (increase(venue_market_traded_contracts_total{env=~\"$env\", namespace=~\"$namespace\"}[$__range]))) * on (market) group_left (title, class) max by (market, title, class) (venue_market_info{env=~\"$env\", namespace=~\"$namespace\"})",
