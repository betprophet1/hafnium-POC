        "query": {
          "query": "label_values(up{component=~\"core|gateway|observer|fix\"}, env)",
          "refId": "env"
        },
        "definition": "label_values(up{component=~\"core|gateway|observer|fix\"}, env)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {},
        "hide": 0,
        "allValue": ".*"
