        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(venue_payout_cents_total{env=~\"$env\", namespace=~\"$namespace\"}[$__range])) / 100",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
