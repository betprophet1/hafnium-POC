{
  "uid": "venue-latency",
  "title": "Latency (per hop)",
  "tags": [
    "venue",
    "system",
    "latency"
  ],
  "description": "Per-hop latency derived from the journal's sequencedAt. Refuses to plot the functional profile.",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "logs",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(up{component=~\"core|gateway|observer|fix\"}, env)",
          "refId": "env"
        },
        "definition": "label_values(up{component=~\"core|gateway|observer|fix\"}, env)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {},
        "hide": 0,
        "allValue": ".*"
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(up{component=~\"core|gateway|observer|fix\", env=~\"$env\"}, namespace)",
          "refId": "namespace"
        },
        "definition": "label_values(up{component=~\"core|gateway|observer|fix\", env=~\"$env\"}, namespace)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {},
        "hide": 0,
        "allValue": ".*"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Venue dashboards",
      "type": "dashboards",
      "tags": [
        "venue"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "text",
      "title": "Read this first",
      "options": {
        "mode": "markdown",
        "content": "Each hop is bounded by software timestamps (`clock` label) on the hosts' system clocks\n(deploy/observability/metrics.md, per-hop latency). **Series labelled `profile=\"functional\"` are never plotted here**\n(blueprint \u00a716): a laptop or ephemeral environment on shared, sleeping cores cannot produce a latency number. If the\nstat on the right is above zero, this environment is functional and the panels below stay empty by design."
      },
      "id": 2,
      "gridPos": {
        "h": 5,
        "w": 18,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Functional series refused",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(count(venue_hop_latency_seconds_count{profile=\"functional\", env=~\"$env\", namespace=~\"$namespace\"}) or vector(0)) + (count(venue_gateway_hop_latency_seconds_count{profile=\"functional\", env=~\"$env\", namespace=~\"$namespace\"}) or vector(0))",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": true,
          "range": false
        }
      ],
      "id": 3,
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Gateway hops p50",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (hop, clock, le) (rate(venue_gateway_hop_latency_seconds_bucket{env=~\"$env\", namespace=~\"$namespace\", profile!=\"functional\"}[$__rate_interval])))",
          "legendFormat": "{{hop}} ({{clock}})",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 5
      }
    },
    {
