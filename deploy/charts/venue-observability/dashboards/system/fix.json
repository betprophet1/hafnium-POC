        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (gc) (rate(jvm_gc_collection_seconds_sum{env=~\"$env\", namespace=~\"$namespace\", component=\"fix\"}[$__rate_interval]))",
          "legendFormat": "{{gc}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "id": 13,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 27
      }
    },
    {
      "type": "row",
      "title": "Logs",
      "id": 14,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "panels": []
    },
    {
      "type": "logs",
      "title": "FIX adapter logs",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=~\"$namespace\", component=\"fix\"}",
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          }
        }
      ],
      "id": 15,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 36
      }
    }
  ]
}
