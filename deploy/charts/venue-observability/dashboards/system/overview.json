      "targets": [
        {
          "refId": "A",
          "expr": "sum by (half) (rate(venue_gateway_http_requests_total{env=~\"$env\", namespace=~\"$namespace\", status=~\"5..\"}[$__rate_interval])) / sum by (half) (rate(venue_gateway_http_requests_total{env=~\"$env\", namespace=~\"$namespace\"}[$__rate_interval]))",
