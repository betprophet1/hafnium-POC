    {
      "type": "bargauge",
      "title": "Capacity used",
      "description": "The tightest of the capacity profile and the sequenced listing limits. Alert at 80%.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
