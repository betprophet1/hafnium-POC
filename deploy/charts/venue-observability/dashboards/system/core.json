{
  "uid": "venue-core",
  "title": "Core and journal",
  "tags": [
    "venue",
    "system"
  ],
  "description": "The node: inputs, journal I/O, sequence, feed subscribers, and capacity headroom derived from the journal.",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "logs",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(up{component=~\"core|gateway|observer|fix\"}, env)",
          "refId": "env"
        },
        "definition": "label_values(up{component=~\"core|gateway|observer|fix\"}, env)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {},
        "hide": 0,
        "allValue": ".*"
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(up{component=~\"core|gateway|observer|fix\", env=~\"$env\"}, namespace)",
          "refId": "namespace"
        },
        "definition": "label_values(up{component=~\"core|gateway|observer|fix\", env=~\"$env\"}, namespace)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {},
        "hide": 0,
        "allValue": ".*"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Venue dashboards",
      "type": "dashboards",
      "tags": [
        "venue"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Inputs",
      "id": 2,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Inputs journaled by type",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (rate(venue_node_inputs_total{env=~\"$env\", namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Sequence",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (pod) (venue_node_sequence{env=~\"$env\", namespace=~\"$namespace\"})",
          "legendFormat": "{{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "id": 4,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Ingress",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(venue_node_ingress_connections{env=~\"$env\", namespace=~\"$namespace\"})",
          "legendFormat": "connections",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(venue_node_ingress_refused_total{env=~\"$env\", namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "refused/s",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "id": 5,
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 1
      }
    },
    {
      "type": "row",
      "title": "Journal",
      "id": 6,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Append (write and flush) p50 / p99",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(venue_node_journal_append_duration_seconds_bucket{env=~\"$env\", namespace=~\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(venue_node_journal_append_duration_seconds_bucket{env=~\"$env\", namespace=~\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "id": 7,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      }
    },
    {
      "type": "timeseries",
      "title": "fsync p50 / p99",
      "description": "Empty unless the core runs with --fsync (core.fsync in the venue-mini chart).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(venue_node_journal_fsync_duration_seconds_bucket{env=~\"$env\", namespace=~\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(venue_node_journal_fsync_duration_seconds_bucket{env=~\"$env\", namespace=~\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      }
    },
    {
      "type": "timeseries",
      "title": "Journal bytes written",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(venue_node_journal_bytes_total{env=~\"$env\", namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "bytes/s",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      }
    },
    {
      "type": "row",
      "title": "Feed",
      "id": 10,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Subscribers",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(venue_node_feed_subscribers{env=~\"$env\", namespace=~\"$namespace\"})",
          "legendFormat": "subscribers",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 19
      }
    },
    {
      "type": "timeseries",
      "title": "Subscriber backlog",
      "description": "Units sent to a subscriber's thread and not yet written to its socket.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(venue_node_feed_subscriber_backlog_units_max{env=~\"$env\", namespace=~\"$namespace\"})",
          "legendFormat": "max",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "sum(venue_node_feed_subscriber_backlog_units_sum{env=~\"$env\", namespace=~\"$namespace\"})",
          "legendFormat": "sum",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 19
      }
    },
    {
      "type": "timeseries",
      "title": "Units published",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(venue_node_feed_units_published_total{env=~\"$env\", namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "units/s",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        },
        {
          "refId": "B",
          "expr": "sum(increase(venue_node_feed_subscribers_disconnected_total{env=~\"$env\", namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "disconnects",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "id": 13,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 19
      }
    },
    {
      "type": "row",
      "title": "Capacity (derived from the journal)",
      "id": 14,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "panels": []
    },
    {
      "type": "bargauge",
      "title": "Used / limit",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "red",
                "value": 0.8
              }
            ]
          },
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (resource) (venue_capacity_used{env=~\"$env\", namespace=~\"$namespace\"}) / on (resource) min by (resource) (venue_capacity_limit{env=~\"$env\", namespace=~\"$namespace\"} > 0)",
          "legendFormat": "{{resource}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "instant": true,
          "range": false
        }
      ],
      "id": 15,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 28
      }
    },
    {
      "type": "table",
      "title": "Used and limits",
      "description": "source=profile: the engine's table size; source=listing: the sequenced limit.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "market"
            },
            "properties": [
              {
                "id": "unit",
                "value": "string"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "event"
            },
            "properties": [
              {
                "id": "unit",
                "value": "string"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value #A": "used",
              "Value #B": "limit"
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "expr": "max by (resource) (venue_capacity_used{env=~\"$env\", namespace=~\"$namespace\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "max by (resource, source) (venue_capacity_limit{env=~\"$env\", namespace=~\"$namespace\"})",
          "legendFormat": "",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "format": "table",
          "instant": true
        }
      ],
      "id": 16,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 28
      }
    },
    {
      "type": "timeseries",
      "title": "Used over time",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (resource) (venue_capacity_used{env=~\"$env\", namespace=~\"$namespace\"})",
          "legendFormat": "{{resource}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          }
        }
      ],
      "id": 17,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 28
      }
    },
    {
      "type": "row",
      "title": "Logs",
      "id": 18,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "panels": []
    },
    {
      "type": "logs",
      "title": "Core logs",
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=~\"$namespace\", component=\"core\"}",
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          }
        }
      ],
      "id": 19,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 37
      }
    }
  ]
}
