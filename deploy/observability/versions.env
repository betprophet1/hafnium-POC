# Pinned versions of the community charts the observability stack installs (deploy/observability/install.sh).
# Change them here, in one place, and read the charts' upgrade notes first.
KUBE_PROMETHEUS_STACK_VERSION=91.4.1   # prometheus-community/kube-prometheus-stack: Prometheus Operator v0.94.0
LOKI_VERSION=7.3.0                     # grafana/loki: Loki 3.6.12
ALLOY_VERSION=1.12.1                   # grafana/alloy: Alloy v1.19.2
