      <field name="state" id="11" type="StateIndex"/>
      <field name="weight" id="12" type="Count"/>
    </group>
  </sbe:message>

  <sbe:message name="ExpireParlay" id="89" description="A leg resolved against the parlay; the contract is worth zero now">
